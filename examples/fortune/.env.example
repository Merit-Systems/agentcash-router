# Required for x402 payments (Base mainnet USDC)
X402_PAYEE_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f8fE00

# Required for Coinbase x402 facilitator
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Optional: MPP payment support (Tempo network)
# If not set, only x402 will be available
MPP_SECRET_KEY=your-64-char-secret-key-for-hmac-challenge-binding
