# Required — origin URL used as the 402 realm and OpenAPI server URL.
BASE_URL=http://localhost:3000

# Required — EVM address that receives x402 and MPP payments (Base mainnet USDC).
EVM_PAYEE_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f8fE00

# Optional — when set, the router also accepts Solana payments. Note: `.upTo()`
# is Base-only and `.metered()` is MPP-only; Solana clients can only pay
# static-priced `.paid()` routes.
# SOLANA_PAYEE_ADDRESS=9tCZP1W2jNYZjikmteU1HRrkoSGaRqcNs9ciLeQZb4a2

# Required in production — Coinbase Developer Platform credentials for the default x402 EVM facilitator.
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Optional — MPP (Tempo) support. Setting MPP_SECRET_KEY toggles MPP on.
# MPP_SECRET_KEY=your-64-char-hmac-secret
# MPP_CURRENCY=0x20c000000000000000000000b9537d11c60e8b50   # TEMPO_USDC_ADDRESS
# TEMPO_RPC_URL=https://user:pass@rpc.mainnet.tempo.xyz
# MPP_OPERATOR_KEY=0x...   # enables session mode; must resolve to EVM_PAYEE_ADDRESS
# MPP_FEE_PAYER_KEY=0x...  # sponsors client gas; must differ from operator

# Optional — Upstash/Vercel KV for SIWX nonce, SIWX entitlement, and MPP replay.
# In-memory fallback is unsafe in serverless production.
# KV_REST_API_URL=https://us1-example.upstash.io
# KV_REST_API_TOKEN=your-upstash-rest-token
