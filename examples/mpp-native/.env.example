# Required: MPP secret key for HMAC-bound challenge IDs
MPP_SECRET_KEY=your-64-char-hex-secret-key

# Required: Recipient address for payments
MPP_RECIPIENT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f8fE00

# Optional: Authenticated Tempo RPC URL
# Without this, on-chain verification will use the default (which may fail)
# TEMPO_RPC_URL=https://user:pass@rpc.mainnet.tempo.xyz
