# --- Required: payment receiver ---

# EVM address that receives x402 and MPP payments (Base mainnet USDC).
# 20 bytes, `0x…`. Canonicalized to lowercase. The zero address is rejected.
EVM_PAYEE_ADDRESS=0x0000000000000000000000000000000000000000

# --- Required in production: x402 facilitator credentials ---

# Coinbase Developer Platform API key — used by the default EVM facilitator.
# Create one in the generous CDP free tier:
# https://portal.cdp.coinbase.com/projects/api-keys
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# --- Optional but recommended on Vercel: BASE_URL ---

# Origin URL. Used as the 402 realm, the OpenAPI server URL, and the MPP memo
# prefix. On Vercel, leave unset and @agentcash/router auto-derives it from
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
# Set this explicitly only if you want to force a specific origin.
# BASE_URL=https://api.example.com

# --- Optional: Solana payments ---

# When set, the router also accepts Solana payments. Note: `.upTo()` is Base-only
# and `.session()` is MPP-only; Solana clients can only pay static-priced `.paid()`.
# SOLANA_PAYEE_ADDRESS=9tCZP1W2jNYZjikmteU1HRrkoSGaRqcNs9ciLeQZb4a2

# --- Optional: MPP (Tempo) ---

# One-shot MPP on `.paid()` routes is on by default: the template derives
# MPP_SECRET_KEY from MPP_OPERATOR_KEY (when set) or EVM_PAYEE_ADDRESS, and
# MPP_CURRENCY defaults to Tempo USDC. Set MPP_SECRET_KEY explicitly for
# production (`openssl rand -hex 32`) — the payee-derived fallback is
# publicly computable. Setting MPP_OPERATOR_KEY auto-enables session mode
# (required for `.session()` request and streaming routes).
# MPP_SECRET_KEY=your-64-char-hmac-secret
# MPP_CURRENCY=0x20c000000000000000000000b9537d11c60e8b50
# TEMPO_RPC_URL=https://user:pass@rpc.mainnet.tempo.xyz
# MPP_OPERATOR_KEY=0x...
# MPP_FEE_PAYER_KEY=0x...

# --- Optional: Base Builder Code (ERC-8021 attribution) ---

# Register at https://dashboard.base.org (Settings → Builder Codes). When set,
# the router declares the builder-code extension on every x402 challenge and
# the facilitator attributes each settled payment to your app on-chain.
# X402_BUILDER_CODE=

# --- Recommended for production: Vercel KV (Upstash Redis) ---
# Required for production-safe SIWX entitlement + MPP replay. Add Upstash Redis /
# Vercel KV from the Vercel Storage tab after deploy; Vercel injects these env vars
# automatically once the store is attached.
# Manual setup: create an Upstash Redis instance and paste the REST URL/token below.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
