# =============================================================================
# @agentcash/router env vars
# =============================================================================
# This file documents every environment variable `createRouterFromEnv` reads.
# Copy to `.env.local` (or your platform's secret store) and fill in values.
#
# The canonical schema is `src/config/schema.ts` (`ENV_SPEC` + `EnvInputSchema`);
# this file is drift-tested against it (see tests/env-drift.test.ts).

# -----------------------------------------------------------------------------
# x402 (required)
# -----------------------------------------------------------------------------

# EVM address that receives x402 and MPP payments (0x-prefixed, 20 bytes).
# Canonicalized to lowercase. The zero address is rejected at startup.
EVM_PAYEE_ADDRESS=

# Coinbase Developer Platform credentials for the default EVM x402 facilitator.
# Required in production.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# -----------------------------------------------------------------------------
# Solana (optional)
# -----------------------------------------------------------------------------

# When set, the router adds a Solana `exact` accept and takes Solana payments.
# Note: `.upTo()` is Base-only and `.metered()` is MPP-only — Solana clients
# can only pay static-priced `.paid()` routes.
# SOLANA_PAYEE_ADDRESS=

# Override the Solana x402 facilitator endpoint.
# Defaults to DEFAULT_SOLANA_FACILITATOR_URL exported from the package.
# SOLANA_FACILITATOR_URL=

# -----------------------------------------------------------------------------
# MPP — Stripe (delegated custody, auto-enabled when STRIPE_SECRET_KEY is set)
# -----------------------------------------------------------------------------

# Stripe secret API key (sk_live_* / sk_test_*). When set, the router mints a
# fresh Stripe crypto-deposit PaymentIntent per request and uses the returned
# Tempo address as the MPP recipient — Stripe captures USDC on settlement and
# credits your Stripe balance. Mutually exclusive with x402 and Tempo MPP.
# Requires MPP_SECRET_KEY (HMAC) and the `stripe` peer dependency.
# .metered() is unsupported in this mode (Stripe's mppx integration is charge-only).
# STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# MPP — Tempo (self-custody, auto-enabled when MPP_SECRET_KEY is set)
# -----------------------------------------------------------------------------

# Server-side MPP HMAC secret. Presence toggles MPP on; for Tempo self-custody
# the three vars below then become required. Also required (without the Tempo
# vars) for Stripe MPP.
# MPP_SECRET_KEY=

# Tempo currency address. Use TEMPO_USDC_ADDRESS exported from the package
# (0x20c000000000000000000000b9537d11c60e8b50).
# MPP_CURRENCY=0x20c000000000000000000000b9537d11c60e8b50

# Authenticated Tempo JSON-RPC endpoint. Public `rpc.tempo.xyz` returns 401.
# TEMPO_RPC_URL=https://user:pass@rpc.mainnet.tempo.xyz

# Operator key — signs server-side close/settle. When set, MPP session mode is
# enabled automatically (required for `.metered()` — both streaming and
# request-mode per-tick billing). The derived address MUST equal the payee.
# MPP_OPERATOR_KEY=

# Fee-payer key — sponsors client gas for channel open/topUp. MUST resolve to a
# different address than MPP_OPERATOR_KEY (Tempo rejects fee-delegated txs
# where sender === feePayer).
# MPP_FEE_PAYER_KEY=

# -----------------------------------------------------------------------------
# Other
# -----------------------------------------------------------------------------

# Origin URL — used as the 402 realm, the OpenAPI server URL, and the MPP memo
# prefix. Load-bearing; must match the public domain or payment matching breaks.
BASE_URL=http://localhost:3000

# Upstash / Vercel KV — backs SIWX nonce, SIWX entitlement, and MPP tx-hash
# replay protection. Missing either var falls back to in-memory storage, which
# is unsafe in serverless production.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
